# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
# Local-only adapter. Never enable this in a deployed environment.
LOCAL_DEV_AUTH=false
LOCAL_DEV_SECRET=replace-with-a-long-random-value

# Supabase (required for hosted auth, database, and private Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENT_BUCKET=startinde-private-documents

# File policy
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_MAX_PAGES=30
DOCUMENT_DAILY_USER_LIMIT=5
DOCUMENT_MONTHLY_USER_LIMIT=30
DOCUMENT_MAX_ESTIMATED_COST_USD=0.10
DOCUMENT_AI_APPROVED=false
OCR_PROCESSING_APPROVED=false

# OpenRouter (optional until reviewed and approved for production)
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_ESCALATION_MODEL=

# NVIDIA (optional)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PRIMARY_MODEL=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=

# Managed OCR (adapter is disabled unless configured)
OCR_PROVIDER=disabled
OCR_API_KEY=
OCR_API_URL=

# Background processing / operations
WORKER_SECRET=
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=120
MALWARE_SCAN_PROVIDER=disabled
MALWARE_SCAN_URL=
MALWARE_SCAN_API_KEY=
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
